# .env 만 막으면 .env.bak / .env.local 같은 사본이 그대로 뚫린다.
# 사본에도 DB 비밀번호·API 키가 전부 들어 있고, 리모트 하나는 공개 레포다.
# add -A 한 번이면 올라가므로 패턴으로 막는다. 예시 파일만 예외.
.env
.env.*
!.env.example
*.bak
__pycache__/
*.pyc
*.db
.playwright/
logs/

# Next.js
web/.next/
web/node_modules/
web/.env.local
web/tsconfig.tsbuildinfo

# 크롬 프로필 / 임시 파일
chrome_profile_amazon/
chrome_profile*/
venv/
debug_profile_test.py
amazon_login_setup.py

# 수집한 상세페이지 원본 이미지 — 1.3GB 다. 추적하면 안 된다.
# gitignore 에 없던 탓에 git status 에 통째로 떠 있었고, add -A 한 번이면
# GitHub 가 거부할 크기가 올라간다. 집계 결과만 web/public/detail/ 로 나간다.
exports/
